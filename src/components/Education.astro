---
import Reveal from "./Reveal";

const coursework = [
  "Data Structures & Algorithms",
  "Database Systems",
  "Operating Systems",
  "Computer Networks",
  "Web Development",
  "Software Engineering",
  "OOP with Java",
];
---

<section id="education" class="border-t border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <Reveal client:visible>
      <div class="mb-14">
        <p
          class="mb-3 text-xs font-medium uppercase tracking-[0.28em] text-[var(--secondary)]"
        >
          04 / Education
        </p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] md:text-5xl">
          Academic background.
        </h2>
      </div>
    </Reveal>

    <Reveal client:visible delay={1}>
      <div
        class="grid gap-8 rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 md:grid-cols-[180px_1fr] md:gap-10 md:p-10"
      >
        <div>
          <p class="text-sm text-[var(--accent)]">2025 — 2027</p>
          <p
            class="mt-2 inline-flex items-center gap-2 text-[11px] uppercase tracking-[0.15em] text-[var(--text-muted)]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
            In progress
          </p>
        </div>

        <div class="max-w-2xl">
          <h3 class="text-xl font-semibold tracking-tight md:text-2xl">
            Bachelor of Computer Applications
          </h3>
          <p class="mt-2 text-base text-[var(--text-muted)]">
            Kathford International College of Engineering and Management
          </p>
          <p class="mt-5 text-sm leading-7 text-[var(--text-muted)]">
            Currently pursuing a BCA with a focus on software development,
            databases, computer systems, and application engineering.
          </p>

          <div class="mt-7">
            <p
              class="mb-3 text-[11px] uppercase tracking-[0.18em] text-[var(--text-muted)]"
            >
              Relevant coursework
            </p>
            <div class="flex flex-wrap gap-2">
              {
                coursework.map((course) => (
                  <span class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-2.5 py-1.5 text-sm">
                    {course}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </Reveal>
  </div>
</section>
