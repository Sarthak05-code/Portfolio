---
import Reveal from "./Reveal";

const projects = [
  {
    number: "01",
    title: "Database Backup CLI",
    description:
      "A Go-based backup and recovery tool for MySQL and MariaDB, supporting automated backups, restoration, compression, and operational management.",
    tags: ["Go", "MySQL", "MariaDB", "Bash"],
    github: "https://github.com/Sarthak05-code/databaseRecovery-app",
  },
  {
    number: "02",
    title: "Hostel Management System",
    description:
      "A full-stack hostel administration platform built with Spring Boot and MySQL, using layered architecture to manage hostel operations and data.",
    tags: ["Java", "Spring Boot", "MySQL", "Thymeleaf", "Tailwind"],
    github: "https://github.com/Sarthak05-code/Hostel-Management-System",
  },
  {
    number: "03",
    title: "Freelance Bidding System",
    description:
      "A lightweight freelance marketplace where clients post tasks and freelancers submit bids, with automated bid management and separate client and admin workflows.",
    tags: ["PHP", "MySQL", "JavaScript", "HTML", "CSS"],
    github: "https://github.com/Sarthak05-code/Freelance---BiddingSystem",
  },
];
---

<section id="work" class="border-t border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <Reveal client:visible>
      <div class="mb-14 flex items-end justify-between gap-6">
        <div>
          <p
            class="mb-3 text-xs font-medium uppercase tracking-[0.28em] text-[var(--secondary)]"
          >
            01 / Selected Work
          </p>
          <h2
            class="text-3xl font-semibold tracking-[-0.04em] md:text-5xl"
          >
            Things I've built.
          </h2>
        </div>
        <span
          class="hidden text-xs uppercase tracking-[0.2em] text-[var(--text-muted)] md:block"
        >
          {projects.length} Projects
        </span>
      </div>
    </Reveal>

    <div class="space-y-0">
      {
        projects.map((project, i) => (
          <Reveal client:visible delay={Math.min(i + 1, 3)}>
            <article class="group grid gap-5 border-t border-[var(--border)] py-8 transition-colors duration-300 hover:bg-[var(--accent-dim)]/40 md:grid-cols-[72px_1fr_auto] md:items-start md:gap-8 md:py-10 md:px-4 md:rounded-xl">
              <span class="text-sm font-medium text-[var(--accent)]">
                {project.number}
              </span>

              <div class="max-w-2xl">
                <h3 class="text-xl font-semibold tracking-tight transition-transform duration-300 group-hover:translate-x-1 md:text-2xl">
                  {project.title}
                </h3>
                <p class="mt-3 text-sm leading-7 text-[var(--text-muted)] md:text-base">
                  {project.description}
                </p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-md border border-[var(--border)] bg-[var(--surface)] px-2.5 py-1 text-[11px] uppercase tracking-wider text-[var(--text-muted)]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>

              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 self-start text-sm font-medium text-[var(--text-muted)] transition-colors duration-300 hover:text-[var(--accent)]"
              >
                Source
                <span aria-hidden="true">↗</span>
              </a>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
