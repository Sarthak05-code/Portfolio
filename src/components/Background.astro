---
/* Ambient black + orange atmosphere — no heavy 3D */
---

<div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <!-- Subtle grid -->
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,var(--grid)_1px,transparent_1px),linear-gradient(to_bottom,var(--grid)_1px,transparent_1px)] bg-[size:56px_56px]"
  >
  </div>

  <!-- Soft orange radial glows -->
  <div
    class="absolute -top-32 left-1/2 h-[520px] w-[720px] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,rgba(255,107,26,0.14)_0%,transparent_70%)]"
  >
  </div>
  <div
    class="absolute bottom-0 right-0 h-[400px] w-[400px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(196,165,116,0.08)_0%,transparent_70%)]"
  >
  </div>
  <div
    class="absolute top-1/3 -left-24 h-[280px] w-[280px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(255,107,26,0.06)_0%,transparent_70%)]"
  >
  </div>

  <!-- Bottom fade so content stays readable -->
  <div
    class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[var(--bg)] to-transparent"
  >
  </div>
</div>
