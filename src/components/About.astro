---
import Reveal from "./Reveal";
---

<section id="about" class="border-t border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-10 md:grid-cols-[200px_1fr] md:gap-14">
      <Reveal client:visible>
        <p
          class="text-xs font-medium uppercase tracking-[0.28em] text-[var(--secondary)]"
        >
          02 / About
        </p>
      </Reveal>

      <div>
        <Reveal client:visible delay={1}>
          <h2
            class="max-w-2xl text-3xl font-semibold leading-tight tracking-[-0.04em] md:text-5xl"
          >
            Building things while figuring out how they work.
          </h2>
        </Reveal>

        <Reveal client:visible delay={2}>
          <p class="mt-6 max-w-xl text-base leading-7 text-[var(--text-muted)] md:text-lg">
            Backend, systems, databases, DevOps. Based in Chobar, Kritipur.
            Born in Birgunj. 20 years old.
          </p>
        </Reveal>

        <Reveal client:visible delay={3}>
          <dl
            class="mt-10 grid grid-cols-1 gap-x-8 gap-y-6 border-t border-[var(--border)] pt-10 sm:grid-cols-2"
          >
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Name
              </dt>
              <dd class="mt-1.5 text-sm font-medium">Sarthak Thapa</dd>
            </div>
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Age
              </dt>
              <dd class="mt-1.5 text-sm font-medium">20</dd>
            </div>
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Born
              </dt>
              <dd class="mt-1.5 text-sm font-medium">
                Dec 31, 2005 — Birgunj, Nepal
              </dd>
            </div>
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Location
              </dt>
              <dd class="mt-1.5 text-sm font-medium">
                Chobar, Kritipur, Nepal
              </dd>
            </div>
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Phone
              </dt>
              <dd class="mt-1.5 text-sm font-medium">
                <a
                  href="tel:+9779864153914"
                  class="transition-colors hover:text-[var(--accent)]"
                >
                  +977 9864153914
                </a>
              </dd>
            </div>
            <div>
              <dt
                class="text-[11px] uppercase tracking-[0.2em] text-[var(--text-muted)]"
              >
                Focus
              </dt>
              <dd class="mt-1.5 text-sm font-medium">
                Backend, Systems, DevOps
              </dd>
            </div>
          </dl>
        </Reveal>
      </div>
    </div>
  </div>
</section>
