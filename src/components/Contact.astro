---
import Reveal from "./Reveal";

const email = "ytsarthak1@gmail.com";
---

<section id="contact" class="border-t border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-12 md:grid-cols-[200px_1fr] md:gap-14">
      <Reveal client:visible>
        <p
          class="text-xs font-medium uppercase tracking-[0.28em] text-[var(--secondary)]"
        >
          05 / Contact
        </p>
      </Reveal>

      <div class="max-w-2xl">
        <Reveal client:visible delay={1}>
          <h2
            class="text-4xl font-semibold leading-[1.05] tracking-[-0.04em] md:text-6xl"
          >
            Got an idea?
            <br />
            <span class="text-[var(--accent)]">I'd love to hear about it.</span>
          </h2>
        </Reveal>

        <Reveal client:visible delay={2}>
          <p
            class="mt-6 max-w-lg text-base leading-8 text-[var(--text-muted)] md:text-lg"
          >
            Have a project, opportunity, or something interesting to discuss?
            Send me a message.
          </p>
        </Reveal>

        <Reveal client:visible delay={3}>
          <form id="contact-form" class="mt-12 space-y-8">
            <div>
              <label
                for="name"
                class="mb-2 block text-sm text-[var(--text-muted)]"
              >
                Name
              </label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                placeholder="Your name"
                class="w-full border-b border-[var(--border)] bg-transparent py-3 text-base outline-none transition-colors placeholder:text-[var(--text-muted)]/60 focus:border-[var(--accent)]"
              />
            </div>

            <div>
              <label
                for="email"
                class="mb-2 block text-sm text-[var(--text-muted)]"
              >
                Email
              </label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="you@example.com"
                class="w-full border-b border-[var(--border)] bg-transparent py-3 text-base outline-none transition-colors placeholder:text-[var(--text-muted)]/60 focus:border-[var(--accent)]"
              />
            </div>

            <div>
              <label
                for="message"
                class="mb-2 block text-sm text-[var(--text-muted)]"
              >
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell me about your idea..."
                class="w-full resize-none border-b border-[var(--border)] bg-transparent py-3 text-base outline-none transition-colors placeholder:text-[var(--text-muted)]/60 focus:border-[var(--accent)]"
              ></textarea>
            </div>

            <div class="flex items-center justify-between gap-6">
              <p
                id="form-status"
                class="text-sm text-[var(--accent)]"
                aria-live="polite"
              >
              </p>
              <button
                type="submit"
                class="group shrink-0 rounded-full bg-[var(--accent)] px-6 py-2.5 text-sm font-semibold text-[var(--bg)] transition-all duration-300 hover:bg-[var(--accent-soft)] hover:shadow-[0_0_24px_-4px_rgba(255,107,26,0.5)]"
              >
                Send message
                <span
                  class="ml-1 inline-block transition-transform group-hover:translate-x-0.5"
                  >↗</span
                >
              </button>
            </div>
          </form>
        </Reveal>

        <p class="mt-10 text-sm text-[var(--text-muted)]">
          Prefer email?
          <a
            href={`mailto:${email}`}
            class="ml-1 font-medium text-[var(--text)] underline underline-offset-4 transition-colors hover:text-[var(--accent)]"
          >
            {email}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector("#contact-form");
  const status = document.querySelector("#form-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!(form instanceof HTMLFormElement)) return;
    if (!(status instanceof HTMLElement)) return;

    status.textContent = "Message sent.";
    form.reset();
    setTimeout(() => {
      status.textContent = "";
    }, 3000);
  });
</script>
