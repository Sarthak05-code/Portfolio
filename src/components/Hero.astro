---
import { Image } from "astro:assets";
import profileImage from "../assets/Profile.jpeg";
import SystemCore from "./SystemCore";
---

<section class="relative min-h-[calc(100vh-5rem)] overflow-hidden">
  <div
    class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-7xl items-center gap-16 px-6 py-20 md:px-10 lg:grid-cols-[1.2fr_0.8fr]"
  >
    <!-- Text -->
    <div class="relative z-10">
      <!-- Avatar -->
      <div
        class="mb-8 h-20 w-20 overflow-hidden rounded-full border border-[var(--border)]"
      >
        <Image
          src={profileImage}
          alt="Sarthak"
          width={160}
          height={160}
          class="h-full w-full object-cover"
        />
      </div>
      <p
        class="mb-6 text-sm uppercase tracking-[0.3em] text-[var(--text-muted)]"
      >
        Software Developer / 2026
      </p>

      <h1
        class="max-w-4xl text-[clamp(4rem,10vw,9rem)] font-semibold leading-[0.85] tracking-[-0.06em]"
      >
        Sarthak
      </h1>

      <h2
        class="mt-6 max-w-2xl text-2xl font-medium tracking-tight text-[var(--text-muted)] md:text-4xl"
      >
        Building digital experiences, interfaces and useful systems.
      </h2>

      <a
        href="#work"
        class="group mt-10 inline-flex items-center gap-4 border border-[var(--border)] px-6 py-4 text-sm font-medium uppercase tracking-[0.15em] transition-colors hover:border-[var(--accent)]"
      >
        View work
        <span
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          →
        </span>
      </a>
    </div>

    <!-- 3D Core (replaces the static circle) -->
    <div class="relative flex min-h-[420px] items-center justify-center">
      <SystemCore client:load />
    </div>
  </div>

  <!-- Bottom metadata -->
  <div
    class="mx-auto flex max-w-7xl items-center justify-between border-t border-[var(--border)] px-6 py-5 text-xs uppercase tracking-[0.2em] text-[var(--text-muted)] md:px-10"
  >
    <span>Developer / Student</span>
    <span>Nepal / 2026</span>
  </div>
</section>
