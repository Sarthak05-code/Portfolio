---
import Reveal from "./Reveal";

const skillCategories = [
  {
    title: "Languages",
    items: ["Java", "JavaScript", "SQL", "Go", "Rust"],
  },
  {
    title: "Backend / DevOps",
    items: ["MySQL", "Azure", "Docker", "Git", "Spring Boot", "CI/CD"],
  },
  {
    title: "Frontend",
    items: ["HTML", "CSS", "React", "Tailwind CSS", "TypeScript"],
  },
];
---

<section id="skills" class="border-t border-[var(--border)] py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <Reveal client:visible>
      <div class="mb-14">
        <p
          class="mb-3 text-xs font-medium uppercase tracking-[0.28em] text-[var(--secondary)]"
        >
          03 / Capabilities
        </p>
        <h2 class="text-3xl font-semibold tracking-[-0.04em] md:text-5xl">
          Tools I work with.
        </h2>
      </div>
    </Reveal>

    <div>
      {
        skillCategories.map((category, i) => (
          <Reveal client:visible delay={Math.min(i + 1, 3)}>
            <div class="grid gap-5 border-t border-[var(--border)] py-7 md:grid-cols-[200px_1fr] md:py-9">
              <h3 class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--text-muted)]">
                {category.title}
              </h3>
              <div class="flex flex-wrap gap-2.5">
                {category.items.map((skill) => (
                  <span class="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2 text-sm tracking-tight transition-all duration-300 hover:border-[var(--accent)]/50 hover:bg-[var(--accent-dim)] hover:text-[var(--accent)] md:text-base">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
