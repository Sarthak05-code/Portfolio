---
const skillCategories = [
  {
    title: "Languages",
    items: ["Java", "JavaScript", "SQL", "Go", "Rust"],
  },
  {
    title: "Backend / DevOps",
    items: ["MySQL", "Azure", "Docker", "Git", "Spring Boot", "CI/CD"],
  },
  {
    title: "Frontend",
    items: ["HTML", "CSS", "React", "Tailwind CSS", "TypeScript"],
  },
];
---

<section id="skills" class="border-t border-[var(--border)] py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-10">
    <!-- Heading -->
    <div class="mb-16">
      <p
        class="mb-4 text-sm uppercase tracking-[0.3em] text-[var(--text-muted)]"
      >
        03 / Capabilities
      </p>

      <h2 class="text-4xl font-semibold tracking-[-0.04em] md:text-6xl">
        Tools I work with.
      </h2>
    </div>

    <!-- Skills -->
    <div>
      {
        skillCategories.map((category) => (
          <div class="grid gap-6 border-t border-[var(--border)] py-8 md:grid-cols-[220px_1fr] md:py-10">
            <h3 class="text-sm font-medium uppercase tracking-[0.18em] text-[var(--text-muted)]">
              {category.title}
            </h3>

            <div class="flex flex-wrap gap-x-6 gap-y-3">
              {category.items.map((skill) => (
                <span class="text-lg tracking-tight transition-transform duration-300 hover:translate-x-1 md:text-xl">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
