---
import "../styles/global.css";
import BackGroundGrid from "../components/BackGroundGrid.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sarthak</title>
    <meta
      name="description"
      content="Sarthak's personal portfolio - software development, experiments and selected works"
    />
  </head>
  <body>
    <BackGroundGrid />
    <main>
      <section class="min-h-screen flex items-center justify-center">
        <div class="text-center">
          <p
            class="mb-4 text-sm uppercase tracking-[0.25em] text-[var(--text-muted)]"
          >
            Portfolio / 2026
          </p>
          <h1 class="text-6xl font-semibold tracking-tight md:text-8xl">
            Sarthak
          </h1>
          <p class="mt-6 text-lg text-[var(--text-muted)]">
            Software Developer
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
